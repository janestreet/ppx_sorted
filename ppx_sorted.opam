opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/ppx_sorted"
bug-reports: "https://github.com/janestreet/ppx_sorted/issues"
dev-repo: "git+https://github.com/janestreet/ppx_sorted.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_sorted/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.2.0"}
  "ocaml_parser"
  "ppx_helpers"
  "dune"                {>= "3.17.0"}
  "ocaml-compiler-libs" {>= "v0.11.0"}
  "ppxlib"              {>= "0.39.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "Ppx rewriter for keeping data-like OCaml code sorted"
description: "
This ppx rewriter validates that annotated lists, variant constructors, record fields, match cases, and bindings are sorted, and emits dune corrections when they are not.
"
